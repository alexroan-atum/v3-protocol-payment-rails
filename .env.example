# ============================================
# Payment Rails — Environment Configuration
# ============================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# Variables marked [REQUIRED] are needed for basic forge test / fork tests.
# Variables marked [DEPLOY] are only needed for deployment scripts.
# Variables marked [OPTIONAL] have sensible defaults in the scripts.

# ============================================
# RPC URLs
# ============================================
# [REQUIRED] Needed for fork tests and mainnet scripts
ETHEREUM_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY
BASE_RPC_URL=https://base-mainnet.g.alchemy.com/v2/YOUR_ALCHEMY_KEY

# [OPTIONAL] Testnets — public RPCs work fine
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# [OPTIONAL] Used by CCTP bridge scripts (source/dest chain RPCs)
SOURCE_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
DEST_RPC_URL=https://sepolia.base.org

# ============================================
# Deployment Account
# ============================================
# [DEPLOY] Option 1: Private key (for broadcast scripts)
# PRIVATE_KEY=0xYOUR_PRIVATE_KEY

# [DEPLOY] Option 2: Mnemonic (for testing)
# MNEMONIC="test test test test test test test test test test test junk"

# ============================================
# Block Explorer API Keys (contract verification)
# ============================================
# [DEPLOY] Get from: https://etherscan.io/myapikey
# ETHERSCAN_API_KEY=YOUR_ETHERSCAN_API_KEY
# BASESCAN_API_KEY=YOUR_BASESCAN_API_KEY

# ============================================
# Deployed Contract Addresses
# ============================================
# [OPTIONAL] Set after deploying — used by smoke/dry-run scripts
# PAYMENT_RAILS_ADDRESS=0x...
# MODULE_ADDRESS=0x...
# BRIDGE_MODULE=0x...

# ============================================
# Forward Module Parameters
# ============================================
# [OPTIONAL] Override defaults in Forward smoke/dry-run scripts
# TOKEN=0x...
# AMOUNT=1000000
# RECIPIENT=0x...
# MIN_AMOUNT=0

# ============================================
# DexSwap Module Parameters
# ============================================
# [OPTIONAL] Override defaults in DexSwap smoke/dry-run scripts
# ROUTER=0xE592427A0AEce92De3Edee1F18E0157C05861564
# SELL_TOKEN=0x...
# BUY_TOKEN=0x...
# SELL_AMOUNT=1000000
# MAX_SLIPPAGE_BPS=500
# POOL_FEE=500
# MAX_STALENESS=3600
# SWAP_DEADLINE=300

# ============================================
# CowSwap Module Parameters
# ============================================
# [OPTIONAL] Override defaults in CowSwap smoke/dry-run scripts
# COWSWAP_API=https://api.cow.fi/base
# SELL_TOKEN=0x...
# BUY_TOKEN=0x...
# SELL_AMOUNT=1000000
# MIN_BUY_AMOUNT=900000
# VALIDITY_DURATION=3600

# ============================================
# CCTP Bridge Module Parameters
# ============================================
# [OPTIONAL] Override defaults in CCTP bridge scripts
# TOKEN_MESSENGER_V2=0x8FE6B999Dc680CcFDD5Bf7EB0974218be2542DAA
# SOURCE_USDC=0x1c7D4B196Cb0C7B01d743Fbc6116a902379C7238
# DEST_USDC=0x036CbD53842c5426634e7929541eC2318f3dCF7e
# SOURCE_DOMAIN=0
# DEST_DOMAIN=6
# BRIDGE_AMOUNT=10000000
# MIN_BALANCE=1000000
# MAX_FEE=0
# FINALITY=2000
# MINT_RECIPIENT=0x...

# [OPTIONAL] Circle attestation API (testnet or mainnet)
# IRIS_API=https://iris-api-sandbox.circle.com
# SOURCE_TX_HASH=0x...

# ============================================
# Foundry Profile
# ============================================
FOUNDRY_PROFILE=default
